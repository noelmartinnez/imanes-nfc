# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# fotos originales: solo se suben las versiones optimizadas de public/fotos
/content/**/*.[jJ][pP][gG]
/content/**/*.[jJ][pP][eE][gG]
/content/**/*.[pP][nN][gG]
/content/**/*.[wW][eE][bB][pP]
/content/**/*.[aA][vV][iI][fF]
/content/**/*.[tT][iI][fF]
/content/**/*.[tT][iI][fF][fF]
/content/**/*.[hH][eE][iI][cC]
/content/**/*.[hH][eE][iI][fF]

# se genera en cada dev/build/test (npm run mapa)
/public/mapa/

# impeccable (local)
/.impeccable/review/
/.impeccable/live/

# zips de fotos originales (se descomprimen en content/)
/imágenes/
